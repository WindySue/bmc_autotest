{
    "WebHardwareInfo": {
        "TestName": "BMC Web硬件信息查询",
        "TestNum": "Web_002",
        "LogBasename": "web_002_hardware_info",
        "BMC_IP": "",
        "UserName": "",
        "PassWord": "",
        "TimeoutSec": 10,
        "CheckItems": [
            {
                "name": "CPU静态信息",
                "type": "cpu_from_collection",
                "required_fields": [
                    "Model",
                    "TotalCores",
                    "ProcessorArchitecture"
                ],
                "resource": "cpu"
            },
            {
                "name": "内存信息",
                "required_fields": [
                    "Members"
                ],
                "resource": "memory"
            },
            {
                "name": "硬盘列表",
                "required_fields": [
                    "Members"
                ],
                "resource": "drives"
            },
            {
                "name": "网络控制器列表",
                "required_fields": [
                    "Members"
                ],
                "resource": "network_adapters"
            },
            {
                "name": "GPU/PCIe设备列表",
                "type": "gpu_optional",
                "resource": "pcie_devices"
            },
            {
                "name": "电源信息",
                "required_fields": [
                    "PowerSupplies"
                ],
                "resource": "power"
            },
            {
                "name": "风扇信息",
                "required_fields": [
                    "Fans"
                ],
                "resource": "thermal"
            },
            {
                "name": "主板FRU",
                "required_fields": [
                    "Manufacturer",
                    "Model",
                    "SerialNumber"
                ],
                "resource": "chassis"
            }
        ]
    }
}
